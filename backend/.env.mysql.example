# MySQL Configuration Template
# Copy this to .env and configure your settings


# MongoDB Configuration (existing)
MONGODB_URI=mongodb://127.0.0.1:27017/website_tanijuu


PORT=5000
NODE_ENV=development

# File Upload
MAX_FILE_SIZE=5242880  # 5MB in bytes
UPLOAD_DIR=uploads

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=website_tanijuu
MYSQL_PORT=3306


DATABASE_TYPE=mysql  # or mongodb

